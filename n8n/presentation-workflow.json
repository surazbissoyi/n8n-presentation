{
  "name": "Presentation Generator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "generate-presentation",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300],
      "webhookId": "generate-presentation"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:4000/api/presentations/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"content\": $json.body.content,\n  \"instructions\": $json.body.instructions,\n  \"n_slides\": $json.body.n_slides,\n  \"tone\": $json.body.tone\n} }}",
        "options": {}
      },
      "id": "call-core-service",
      "name": "Call Generation Service",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}"
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [780, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Call Generation Service", "type": "main", "index": 0 }]]
    },
    "Call Generation Service": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
